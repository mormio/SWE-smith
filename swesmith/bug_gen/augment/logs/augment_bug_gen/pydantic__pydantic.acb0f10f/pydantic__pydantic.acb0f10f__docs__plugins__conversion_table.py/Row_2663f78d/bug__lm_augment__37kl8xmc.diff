+        str,
+        str,
+        strict=True,
+        python_input=True,
+        json_input=True,
+        core_schemas=[core_schema.StringSchema],
+        default=''  # Added default value
+    ),
+    # Other rows...
+]
+
+conversion_table = ConversionTable(table_rows).sorted()
